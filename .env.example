# Incident Evidence Compiler - Runtime Environment Configuration
# Copy this file to .env and adjust values for your environment.

# ------------------------------------------------------------------------------
# Authentication (Required)
# ------------------------------------------------------------------------------
# Comma-separated token=tenant pairs mapping bearer tokens to tenant identifiers.
IEC_TOKENS=dev-token=tenant-a,demo-token=tenant-demo

# ------------------------------------------------------------------------------
# Persistence
# ------------------------------------------------------------------------------
# Choices: "memory" (default), "postgres"
IEC_PERSISTENCE=memory

# Required if IEC_PERSISTENCE=postgres:
# IEC_DATABASE_URL=postgresql://iec:iec@localhost:5432/iec

# ------------------------------------------------------------------------------
# LLM Provider
# ------------------------------------------------------------------------------
# Choices: "fake" (non-model smoke, default), "developer", "vertex"
IEC_LLM_PROVIDER=fake

# Required if IEC_LLM_PROVIDER=developer:
# GEMINI_API_KEY=your_gemini_api_key_here

# Required if IEC_LLM_PROVIDER=vertex:
# IEC_GEMINI_PROJECT=your-gcp-project-id
# IEC_GEMINI_LOCATION=us-central1

# Gemini model identifier (default: gemini-2.5-flash)
# IEC_GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# Telemetry Ingestion
# ------------------------------------------------------------------------------
# Choices: "none" (default), "rcaeval" (demo benchmark bridge), "prometheus" (live)
IEC_TELEMETRY=none

# Required if IEC_TELEMETRY=rcaeval:
# IEC_RE2_ROOT=/path/to/extracted/RE2-OB
# IEC_RE2_SPLIT=OB

# Required if IEC_TELEMETRY=prometheus:
# Base URL of Prometheus instance to query range.
# IEC_PROM_URL=http://localhost:9090

# Semicolon-separated PromQL selectors (semicolons used because PromQL labels use commas).
# IEC_PROM_QUERIES=sum by (service) (rate(http_request_duration_seconds_sum[1m])) ; sum by (service) (rate(http_requests_total{code=~"5.."}[1m]))

# Prometheus query options:
# IEC_PROM_STEP_SECONDS=30
# IEC_PROM_TIMEOUT_SECONDS=30.0
# IEC_PROM_BEARER_TOKEN=

# ------------------------------------------------------------------------------
# Server & In-Process Worker
# ------------------------------------------------------------------------------
IEC_BIND_HOST=127.0.0.1
IEC_BIND_PORT=8000
IEC_WORKER_ENABLED=true
IEC_WORKER_IDLE_SLEEP_SECONDS=1.0

# Verifier minimum suspicion score threshold (float >= 0.0).
# Worker default is 1.0; set to 3.0 to match the evaluated benchmark configuration.
# IEC_BASELINE_MIN_SCORE=1.0
